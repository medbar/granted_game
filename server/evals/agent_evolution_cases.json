{
  "version": "agent-world-effects-v2",
  "cases": [
    {"id":"create_sword_world","wish":"Создай меч рядом со мной","expected":{"objects":[{"prototype":"sword","count":1}]}},
    {"id":"create_wall","wish":"Создай стену перед игроком","expected":{"objects":[{"prototype":"wall","count":1}]}},
    {"id":"create_four_walls","wish":"Создай четыре стены вокруг игрока","expected":{"objects":[{"prototype":"wall","count":4}]}},
    {"id":"phase_player","wish":"Сделай так, чтобы игрок проходил сквозь стены","expected":{"states":[{"target":"player","name":"phased"}],"properties":[{"target":"player","name":"passes_walls","value":true}]}},
    {"id":"phase_enemy","wish":"Сделай так, чтобы враг проходил сквозь стены","expected":{"states":[{"target":"enemy_01","name":"phased"}]}},
    {"id":"phase_npc","wish":"Сделай так, чтобы НПС проходил сквозь стены","expected":{"states":[{"target":"npc_01","name":"phased"}]}},
    {"id":"burn_player","wish":"Подожги игрока","expected":{"states":[{"target":"player","name":"burning"}]}},
    {"id":"burn_enemy","wish":"Подожги врага","expected":{"states":[{"target":"enemy_01","name":"burning"}]}},
    {"id":"burn_npc","wish":"Подожги НПС","expected":{"states":[{"target":"npc_01","name":"burning"}]}},
    {"id":"wet_player","wish":"Сделай игрока мокрым","expected":{"states":[{"target":"player","name":"wet"}],"wetness":[{"target":"player","minimum":0.9}]}},
    {"id":"wet_enemy","wish":"Облей врага водой, чтобы он стал мокрым","expected":{"states":[{"target":"enemy_01","name":"wet"}],"wetness":[{"target":"enemy_01","minimum":0.9}]}},
    {"id":"wet_npc","wish":"Сделай НПС мокрым","expected":{"states":[{"target":"npc_01","name":"wet"}],"wetness":[{"target":"npc_01","minimum":0.9}]}},
    {"id":"invisible_player","wish":"Сделай игрока невидимым","expected":{"states":[{"target":"player","name":"invisible"}],"properties":[{"target":"player","name":"invisible","value":true}]}},
    {"id":"invisible_enemy","wish":"Сделай врага невидимым","expected":{"states":[{"target":"enemy_01","name":"invisible"}]}},
    {"id":"invisible_npc","wish":"Сделай НПС невидимым","expected":{"states":[{"target":"npc_01","name":"invisible"}]}},
    {"id":"aggro_enemy_player","wish":"Заставь врага агриться на игрока","expected":{"aggro":[{"actor":"enemy_01","target":"player"}]}},
    {"id":"give_sword_inventory","wish":"Создай меч прямо в рюкзаке игрока","expected":{"inventory":[{"owner":"player","prototype":"sword"}]}},
    {"id":"give_key_inventory","wish":"Положи магический ключ в рюкзак игрока","expected":{"inventory":[{"owner":"player","prototype":"magic_key"}]}},
    {"id":"create_trap","wish":"Создай ловушку рядом с врагом","expected":{"objects":[{"prototype":"trap","count":1,"near":"enemy_01"}]}},
    {"id":"destroy_rock","wish":"Полностью уничтожь камень","expected":{"destroyed":["rock_01"]}},
    {"id":"create_shield_variant","wish":"Сотвори щит рядом со мной","expected":{"objects":[{"prototype":"shield","count":1}]}},
    {"id":"create_key_variant","wish":"Призови ключ перед игроком","expected":{"objects":[{"prototype":"key","count":1}]}},
    {"id":"create_portal_variant","wish":"Создай портал возле меня","expected":{"objects":[{"prototype":"portal","count":1}]}},
    {"id":"create_actor_batch","wish":"Создай 3 врагов и 2 NPC","expected":{"objects":[{"prototype":"enemy","count":3},{"prototype":"npc","count":2}]}},
    {"id":"equip_dress","wish":"Одень меня в платье","expected":{"properties":[{"target":"player","name":"outfit","value":"dress"}]}},
    {"id":"equip_robe","wish":"Наряди игрока в мантию","expected":{"properties":[{"target":"player","name":"outfit","value":"robe"}]}},
    {"id":"equip_armor","wish":"Одень игрока в броню","expected":{"properties":[{"target":"player","name":"outfit","value":"armor"}]}},
    {"id":"equip_cloak","wish":"Накинь на меня плащ","expected":{"properties":[{"target":"player","name":"outfit","value":"cloak"}]}},
    {"id":"transform_rock_crate","wish":"Преврати камень в коробку","expected":{"properties":[{"target":"rock_01","name":"prototype","value":"crate"}]}},
    {"id":"transform_enemy_rock","wish":"Преврати врага в камень","expected":{"properties":[{"target":"enemy_01","name":"prototype","value":"rock"}]}},
    {"id":"transform_npc_enemy","wish":"Преврати NPC во врага","expected":{"properties":[{"target":"npc_01","name":"prototype","value":"enemy"}]}},
    {"id":"transform_crate_tree","wish":"Преврати ящик в дерево","expected":{"properties":[{"target":"crate_01","name":"prototype","value":"tree"}]}},
    {"id":"pause_game","wish":"Поставь игру на паузу","expected":{"properties":[{"target":"player","name":"world_paused","value":true}]}},
    {"id":"resume_game","wish":"Сними с паузы игру","expected":{"properties":[{"target":"player","name":"world_paused","value":false}]}},
    {"id":"slow_game","wish":"Замедли игру","expected":{"properties":[{"target":"player","name":"game_time_scale","value":0.5}]}},
    {"id":"speed_game","wish":"Ускорь игру","expected":{"properties":[{"target":"player","name":"game_time_scale","value":2.0}]}},
    {"id":"darken_world","wish":"Сделай мир темнее","expected":{"properties":[{"target":"player","name":"light_level","value":0.3}]}},
    {"id":"lights_out","wish":"Погаси свет во всём мире","expected":{"properties":[{"target":"player","name":"light_level","value":0.3}]}},
    {"id":"brighten_world","wish":"Сделай мир светлее","expected":{"properties":[{"target":"player","name":"light_level","value":1.6}]}},
    {"id":"flood_with_light","wish":"Залей светом весь мир","expected":{"properties":[{"target":"player","name":"light_level","value":1.6}]}}
  ]
}
